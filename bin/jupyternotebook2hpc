mkdir -p "${LOGDIR}"
CLIENT_LOG_FILE="jupyclient.log.${MYDATE}"
inform "JUPYTERSERVER CLIENT ${CLIENT//*\//} LOGGING:" "${LOGDIR}/${CLIENT_LOG_FILE}"
REMOTE_LOGDIR="\$HOME/jupyter_logs/${MACHINE}"
SERVER_LOG_FILE="jupyserver.log.${MYDATE}"

#    else
#        inform "ATTEMPTING CONNECTION TO REQUESTED REMOTE_DISPLAY" "localhost:$(( 11111+${REMOTE_DISPLAY} ))"
#    fi
#fi

# ensure that we limit displays to one per user per host, if there are more than one jupyservers running for $MACHUSER, force a kill, exit, or reuse of that server
# for someone interested sufficiently to avoid this, note that the -b option sets BACKDOOR="true", therefore bypassing this
#if [[ "${#active_displays[@]}" -ge 1 ]] && [[ $RECONNECT != "true" ]] && [[ $BACKDOOR != "true" ]] ; then

# generate a random display number
if [[ "${REMOTE_DISPLAY}"x == x ]] ; then
    REMOTE_DISPLAY=0
    FLOOR=11111
    RANGE=60000
    while ! [[ ${all_active_displays[@]} =~ '${REMOTE_DISPLAY}' ]] && ( [ "$REMOTE_DISPLAY" -le $FLOOR ] || [ "$REMOTE_DISPLAY" -gt $RANGE ] ) ; do
        REMOTE_DISPLAY=$RANDOM
    done
fi

message -g "REMOTE_DISPLAY:" "$REMOTE_DISPLAY"
# test local tunnel connections for conflicts
until ! lsof -i -n |grep "127.0.0.1:${REMOTE_DISPLAY}" &>/dev/null ; do
    TUNNEL_CONFLICT=$(lsof -i -n |grep "127.0.0.1:${REMOTE_DISPLAY}")
    debug "DETECTED TUNNEL CONFLICT:" "${TUNNEL_CONFLICT}"
    # Increment $REMOTE_DISPLAY to avoid conflict
    REMOTE_DISPLAY=$(( $REMOTE_DISPLAY+1 ))
    REMOTE_DISPLAY=${REMOTE_DISPLAY}
    inform "TUNNEL CONFLICT:" "${TUNNEL_CONFLICT}"
    inform "NEW REMOTE_DISPLAY:" "${REMOTE_DISPLAY}"
done

# get tunnel string
TUNNEL_HOST=$(setup_tunnel_host)

# need the tunnel to include the display as determined above
if [[ "${NETWORK}" =~ TURQUOISE ]] ; then
    GATEWAY="wtrw.lanl.gov"
    GATEWAY_TUNNEL=$(setup_gateway_tunnel ${GATEWAY})
elif [[ "${NETWORK}" =~ VLGATE ]] ; then
    GATEWAY="vl-gate.lanl.gov"
    GATEWAY_TUNNEL=$(setup_gateway_tunnel ${GATEWAY})
else
    NO_GATEWAY_TUNNEL=$(setup_nogateway_tunnel)
fi

debug "TUNNEL FOR ${NETWORK}:" "${NO_GATEWAY_TUNNEL} ${GATEWAY_TUNNEL}"

# generic tunnel invocation
debug "RUNNING:" "${GATEWAY_TUNNEL}${NO_GATEWAY_TUNNEL} sleep 25 &>/dev/null &"
${GATEWAY_TUNNEL} ${NO_GATEWAY_TUNNEL} &>/dev/null &
tunnel_pid=$!

# establish a ssh local tunnel to $MACHINE
debug "STARTING PORT FORWARDING" "`hostname -s` TO ${MACHINE} ON PORT ${REMOTE_DISPLAY}"
debug "TUNNEL PID IS:" "${tunnel_pid}"


# if the display requested isn't already actively listening for USER, call startjupyserver script remotely
if ! [[ "${active_displays[@]}" =~ $REMOTE_DISPLAY ]] ; then
    ${GATEWAY_SSH} ${NO_GATEWAY_SSH} "mkdir -p ${REMOTE_LOGDIR} && ${JUPYTERSERVER_PATH} notebook --no-browser --notebook-dir=${NOTEBOOK_DIR} --port=${REMOTE_DISPLAY} &>${REMOTE_LOGDIR}/${SERVER_LOG_FILE}" > ${LOGDIR}/${SERVER_LOG_FILE} 2>&1 </dev/null
    sleep 20
    
    url=$(${GATEWAY_SSH} ${NO_GATEWAY_SSH} "grep http ${REMOTE_LOGDIR}/${SERVER_LOG_FILE}")
    newport=$(${GATEWAY_SSH} ${NO_GATEWAY_SSH} "grep http ${REMOTE_LOGDIR}/${SERVER_LOG_FILE} | awk '{print \$NF}' | awk -F: '{print \$NF}' | sed 's/\///g'")
    # turquoise network connection requires parsing weird carriage return characters
    newport=${newport%$'\r'}
    if [[ "${newport}" =~ FAIL ]] || [[ "${newport}" == "0" ]] || [[ -z "${newport}" ]] ; then
        die "START JUPY RETURNS" "$(echo $newport)"
    else
        # reassign port here to the actual port jupyserver established
        REMOTE_DISPLAY="${newport}"
    fi
    sleep 2.5
else
    debug "JUPYTERSERVER RUNNING AS $USER ALREADY on $REMOTE_DISPLAY" "WILL USE THIS REMOTE_DISPLAY $REMOTE_DISPLAY"
fi

# test that the Xjupy process on $REMOTE_DISPLAY was instantiated
remote_pid=$( ${GATEWAY_SSH} ${NO_GATEWAY_SSH} "ps aux" 2>&- \
              | awk -v exclude="awk" -v pat="${REMOTE_DISPLAY} " '($0 !~ exclude) && $0~pat{print $2}' )
debug "JUPYTERSERVER PID IS:" "${remote_pid}"

# fail if not
if [[ "${remote_pid}x" == x ]] ; then
    die "ERROR OCCURRED STARTING JUPYTERSERVER."
fi

inform "CONNECTING $CLIENT_VERSION TO TUNNEL VIA:" "localhost:$REMOTE_DISPLAY"
inform "WHILE RUNNING:" "KEEP THIS TERMINAL ACTIVE!"
inform "TO TERMINATE:" "CLOSE $CLIENT_VERSION WINDOW OR CTRL+c COMMAND IN TERMINAL"

# connect client to localhost
$CLIENT ${CLIENT_OPT[@]} $url
#"$CLIENT" http://localhost:${REMOTE_DISPLAY} ${CLIENT_OPT[@]} >> ${LOGDIR}/${CLIENT_LOG_FILE} 2>&1

# test client connection return code
if [[ $? -ne 0 ]] ; then
    message -r "FAILURE CONNECTING $CLIENT TO $REMOTE_DISPLAY"
fi


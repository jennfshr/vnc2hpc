    [[ "${REMOTE_DISPLAY}" =~ ^[0-9]+$ ]] || die "REMOTE_DISPLAY isnt a number, or is unset" "REMOTE_DISPLAY=$REMOTE_DISPLAY"
    [[ "${REMOTE_DISPLAY}" -le 13000 ]] || die "REMOTE_DISPLAY must not exceed 13000!" "REMOTE_DISPLAY=${REMOTE_DISPLAY}"
fi

# Check out the jupyclient
if [[ "${CLIENT}x" == x ]] ; then usage; die "A PATH TO A BROWSER CLIENT MUST BE SUPPLIED TO ${0/\*/}!" ; fi
if ! $(client_check 2>&-) ; then die "$CLIENT" "FAILED BASIC TESTS" "RECHECK YOUR PATH TO JUPYTERSERVERVIEWER" ; fi
CLIENT_VERSION=$(client_version)
inform "JUPYTERSERVER CLIENT INFO:" "$CLIENT_VERSION"

# uname output on local host
CLIENTOS=$(clientOS)
